# Unified Social Club backend settings for the OCS server.
# Copy to deploy/usc.env on the server and fill in. usc.env is never committed.

IS_PRODUCTION=true
FLASK_PORT=8588

# A long random value, different from every other OCS backend.
SECRET_KEY=

# Our own cookie names. In production the login cookie is set on
# .opencodingsociety.com, so the OCS defaults (jwt_python_flask, sess_python_flask)
# would overwrite a student's OCS login, and theirs ours.
JWT_TOKEN_NAME=jwt_usc_flask
SESSION_COOKIE_NAME=sess_usc_flask

# Starter accounts made by scripts/db_init.py. Without these, every starter
# account (admin, teacher, user) gets the password "password".
ADMIN_UID=
ADMIN_PASSWORD=
DEFAULT_PASSWORD=
